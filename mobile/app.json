{
  "expo": {
    "name": "PulseCoach",
    "slug": "pulsecoach",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pulsecoach",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.boraerenerdem.pulsecoach",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true,
        "NSFaceIDUsageDescription": "Uygulama kilidini Face ID ile açabilmen için gerekiyor."
      }
    },
    "android": {
      "package": "com.boraerenerdem.pulsecoach",
      "adaptiveIcon": {
        "backgroundColor": "#D9562A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "locales": {
      "tr": "./locales/tr.json",
      "en": "./locales/en.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FBF6ED",
          "dark": {
            "backgroundColor": "#10161A"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Yemek fotoğrafı seçip besin analizine göndermek için galeriye erişim gerekiyor.",
          "cameraPermission": "Yemek fotoğrafı çekip besin analizine göndermek için kameraya erişim gerekiyor.",
          "microphonePermission": false
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["tr", "en"]
          }
        }
      ],
      "expo-notifications",
      "expo-dev-client",
      "expo-apple-authentication",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Günlük adım sayını Apple Sağlık'tan okuyup koçunla birlikte göstermek için gerekiyor. Yalnız adım sayısı okunur, Sağlık'a hiçbir şey yazılmaz.",
          "NSHealthUpdateUsageDescription": "PulseCoach Apple Sağlık'a veri yazmaz; yalnız günlük adım sayını okur. Bu izin istenmez.",
          "background": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ba9046fc-64ab-4454-a867-e22c3e7cdebc"
      }
    },
    "owner": "boraerenerdem"
  }
}
