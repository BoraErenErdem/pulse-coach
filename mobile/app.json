{
  "expo": {
    "name": "PulseCoach",
    "slug": "pulsecoach",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pulsecoach",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.boraerenerdem.pulsecoach",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Uygulama kilidini Face ID ile açabilmen için gerekiyor."
      }
    },
    "android": {
      "package": "com.boraerenerdem.pulsecoach",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Yemek fotoğrafı seçip besin analizine göndermek için galeriye erişim gerekiyor.",
          "cameraPermission": "Yemek fotoğrafı çekip besin analizine göndermek için kameraya erişim gerekiyor."
        }
      ],
      "expo-localization",
      "expo-notifications",
      "expo-dev-client"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ba9046fc-64ab-4454-a867-e22c3e7cdebc"
      }
    },
    "owner": "boraerenerdem"
  }
}
