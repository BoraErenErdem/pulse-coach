# PulseCoach - web arayüzü (Next.js): tanıtım sayfası, uygulama, şifre sıfırlama,
# mağazaların istediği /kvkk ve /terms. setup.sh /etc/systemd/system'e kopyalar.
[Unit]
Description=PulseCoach - web
After=network-online.target
Wants=network-online.target

[Service]
User=pulsecoach
Group=pulsecoach
WorkingDirectory=/srv/pulsecoach/pulse-coach/web
Environment=PATH=/srv/pulsecoach/opt/node/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/srv/pulsecoach/pulse-coach/web/node_modules/.bin/next start -H 127.0.0.1 -p 3000
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
