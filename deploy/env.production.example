# PulseCoach canlı ayarları - sunucuda /srv/pulsecoach/pulse-coach/.env olur
# (setup.sh ilk çalıştırmada kendisi kopyalar). Bu dosya git'te; gerçek .env DEĞİL.
# JWT_SECRET_KEY ve DATABASE_URL boş bırakılırsa setup.sh rastgele üretir.

JWT_SECRET_KEY=
DATABASE_URL=

# LLM (aynı sunucudaki Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL_NAME=gemma4:e4b
PHOTO_VISION_MODEL_NAME=gemma4:12b
# Modeller bellekte kalsın: ilk kullanıcı soğuk yüklemeyi (~10-20 sn) beklemesin.
LLM_KEEP_ALIVE=24h
# Ölçülen istem: medyan ~11.9k, en büyük ~16.1k token + çıktı 3k'ya kadar
# (deploy/README.md "Ollama ayarı"). FA + q8_0 KV ile 32768, f16 20000'den az VRAM tutar.
LLM_NUM_CTX=32768

# Alan adları. setup.sh Caddy'yi bunlardan kurar: FRONTEND_BASE_URL -> 127.0.0.1:3000
# (www. öneki buraya yönlenir), NEXT_PUBLIC_API_BASE_URL -> 127.0.0.1:8000.
NEXT_PUBLIC_API_BASE_URL=https://api.pulsecoachapp.com
FRONTEND_BASE_URL=https://pulsecoachapp.com
CORS_ALLOWED_ORIGINS=https://pulsecoachapp.com

# Süreçler "pulsecoach" kullanıcısıyla çalışır ve koda yazamaz: gömme önbellekleri
# veri dizininde tutulur.
FAISS_INDEX_PATH=/srv/pulsecoach/data/faiss_index
CATALOG_VECTORS_DIR=/srv/pulsecoach/data/catalog_vectors

# Yedekleme (worker her gece BACKUP_HOUR'da, UTC). Sunucu dışı kopya için
# /srv/pulsecoach/secrets/rclone.conf + BACKUP_RCLONE_REMOTE (deploy/README.md).
BACKUP_DIR=/srv/pulsecoach/backups
PG_DUMP_PATH=/usr/lib/postgresql/17/bin/pg_dump
RCLONE_PATH=/srv/pulsecoach/opt/bin/rclone
BACKUP_RCLONE_REMOTE=
BACKUP_HOUR=0
# /health/ready yedek bu kadar saatten eskiyse 503 verir (uptime izleyicisi yakalar).
HEALTH_MAX_BACKUP_AGE_HOURS=36

# Günlük kota (kullanıcının yerel gece yarısında yenilenir; 0 = sınırsız)
CHAT_DAILY_LIMIT=100
PHOTO_DAILY_LIMIT=20

# E-posta (şifre sıfırlama). Boşsa link yalnız loga yazılır - canlıda DOLDURUN.
# SMTP_FROM_EMAIL ayrıca Let's Encrypt'e sertifika uyarıları için bildirilir.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Google / Apple ile giriş (virgülle ayrılmış client ID'ler). Apple yalnız iOS
# uygulamasında: APPLE_CLIENT_IDS = uygulamanın bundle kimliği (web'de Apple yok).
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=
